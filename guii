-- ══════════════════════════════════════════════════════════
-- BOOT ANIMATION  (staggered, 1.2 s total)
-- ══════════════════════════════════════════════════════════
--
-- Sequence:
--   0.00 s  — discord tag + Frame 1 bar fade in  (0.5 s)
--   0.35 s  — main panel fades in               (0.6 s)
--   0.70 s  — left/right boxes slide-settle     (subtle)
--   0.95 s  — border pulse on both frames       (0.3 s ping-pong)
--
-- We accomplish this with a single GroupTransparency tween on Root,
-- then individual alpha tweens on the sub-CanvasGroups below.
-- For simplicity (and to avoid excessive CanvasGroup nesting which
-- costs performance), we use Position offsets + transparency tweens
-- on the Frame children directly instead.
-- ──────────────────────────────────────────────────────────

task.spawn(function()
    -- Ensure everything is invisible at frame 0
    Root.GroupTransparency = 1
    Bar.BackgroundTransparency  = 1
    Panel.BackgroundTransparency = 1

    task.wait(0.05)  -- let Roblox finish parenting

    -- ① Fade in the discord label + top bar
    tween(Root, { GroupTransparency = 0 }, 1.0,
          Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    -- ② Delay the bar becoming visible (it fades from BG transparent)
    task.delay(0.0, function()
        tween(Bar, { BackgroundTransparency = 0 }, 0.5,
              Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end)

    -- ③ Main panel comes in slightly after
    task.delay(0.30, function()
        tween(Panel, { BackgroundTransparency = 0 }, 0.6,
              Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end)

    -- ④ Border pulse on Bar
    task.delay(0.80, function()
        local s = Bar:FindFirstChildOfClass("UIStroke")
        if s then
            tween(s, { Thickness = 2.5 }, 0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            task.delay(0.18, function()
                tween(s, { Thickness = 1 }, 0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            end)
        end
    end)

    -- ⑤ Border pulse on Panel
    task.delay(1.00, function()
        local s = Panel:FindFirstChildOfClass("UIStroke")
        if s then
            tween(s, { Thickness = 2.5 }, 0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            task.delay(0.18, function()
                tween(s, { Thickness = 1 }, 0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            end)
        end
    end)

    task.delay(1.2, function()
        print("[ChuoiHub] ✓ Boot sequence complete.")
    end)
end)
