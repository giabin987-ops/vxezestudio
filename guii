-- LIVE DATA BINDING
-- ══════════════════════════════════════════════════════════

local cachedData = nil
local startTime  = os.clock()

-- Safely bind a Value object inside Data
local function bindValue(data, valueName, callback)
    local obj = data:FindFirstChild(valueName)
    if not obj then return end
    -- Fire immediately with current value
    pcall(callback, obj.Value)
    -- Fire on every change
    obj:GetPropertyChangedSignal("Value"):Connect(function()
        pcall(callback, obj.Value)
    end)
end

local function updateSeaLabel(seaVal)
    local n = tonumber(seaVal)
    local inThird = (n == 3) or (tostring(seaVal):lower():find("third") ~= nil)
    if inThird then
        thirdSeaLabel.Text      = "Third Sea : ✓"
        thirdSeaLabel.TextColor3 = C.GREEN
    else
        thirdSeaLabel.Text       = "Third Sea : ✗"
        thirdSeaLabel.TextColor3  = Color3.fromRGB(200, 80, 80)
    end
end

task.spawn(function()
    -- Wait up to 15 s for the Data folder to exist
    local dataFolder = LocalPlayer:WaitForChild("Data", 15)
    if not dataFolder then
        warn("[ChuoiHub] Data folder not found — live stats disabled.")
        return
    end
    cachedData = dataFolder

    bindValue(dataFolder, "Level", function(v)
        levelVal.Text = tostring(v)
    end)

    bindValue(dataFolder, "Race", function(v)
        raceVal.Text = tostring(v)
    end)

    bindValue(dataFolder, "Beli", function(v)
        beliVal.Text = fmtNumber(v)
    end)

    bindValue(dataFolder, "Fragments", function(v)
        fragVal.Text = fmtNumber(v)
    end)

    -- Sea detection — Blox Fruits may store this differently per version
    local seaObj = dataFolder:FindFirstChild("Sea")
               or dataFolder:FindFirstChild("CurrentSea")
               or dataFolder:FindFirstChild("SeaName")
    if seaObj then
        updateSeaLabel(seaObj.Value)
        seaObj:GetPropertyChangedSignal("Value"):Connect(function()
            updateSeaLabel(seaObj.Value)
        end)
    end
end)

-- ══════════════════════════════════════════════════════════
-- HEARTBEAT  —  live timer + status bar refresh
-- ══════════════════════════════════════════════════════════

RunService.Heartbeat:Connect(function()
    local elapsed = os.clock() - startTime
    local eStr    = fmtElapsed(elapsed)

    -- Row 2 item label — mirrors screenshot format
    itemLabel.Text = "Item : Time Machine | " .. eStr

    -- Row 3 status bar
    local lv, sea, fr = "?", "?", "?"
    if cachedData then
        local lo = cachedData:FindFirstChild("Level")
        local so = cachedData:FindFirstChild("Sea")
                or cachedData:FindFirstChild("CurrentSea")
        local fo = cachedData:FindFirstChild("Fragments")
        if lo then lv  = tostring(lo.Value) end
        if so then sea = tostring(so.Value) end
        if fo then fr  = fmtNumber(fo.Value) end
    end

    statusLabel.Text = string.format("Lv.%s | Sea%s | Frag:%s | %s", lv, sea, fr, eStr)
end)

