-- ════════════════════════════════════════════
-- LIVE DATA BINDING
-- ════════════════════════════════════════════
local cachedData = nil
local startTime  = os.clock()

local function bindVal(data, name, cb)
    local obj = data:FindFirstChild(name)
    if not obj then return end
    pcall(cb, obj.Value)
    obj:GetPropertyChangedSignal("Value"):Connect(function()
        pcall(cb, obj.Value)
    end)
end

local function updateSea(v)
    local n = tonumber(v)
    local is3 = (n == 3) or (tostring(v):lower():find("third") ~= nil)
    if is3 then
        thirdSea.Text      = "Third Sea : ✓"
        thirdSea.TextColor3 = C.GREEN
    else
        thirdSea.Text       = "Third Sea : ✗"
        thirdSea.TextColor3  = C.SEA_NO
    end
end

task.spawn(function()
    local data = LP:WaitForChild("Data", 15)
    if not data then
        warn("[ChuoiHub] Data folder not found — stats disabled.")
        return
    end
    cachedData = data

    bindVal(data, "Level",     function(v) levelVal.Text = tostring(v) end)
    bindVal(data, "Race",      function(v) raceVal.Text  = tostring(v) end)
    bindVal(data, "Beli",      function(v) beliVal.Text  = fmtNum(v)   end)
    bindVal(data, "Fragments", function(v) fragVal.Text  = fmtNum(v)   end)

    -- Sea detection (Blox Fruits varies by version)
    local seaObj = data:FindFirstChild("Sea")
                or data:FindFirstChild("CurrentSea")
                or data:FindFirstChild("SeaName")
    if seaObj then
        updateSea(seaObj.Value)
        seaObj:GetPropertyChangedSignal("Value"):Connect(function()
            updateSea(seaObj.Value)
        end)
    end
end)

-- ════════════════════════════════════════════
-- HEARTBEAT — timer + status bar
-- ════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    local e = os.clock() - startTime
    local t = fmtElapsed(e)

    itemLbl.Text = "Item : Time Machine | " .. t

    local lv, sea, fr = "?", "?", "?"
    if cachedData then
        local lo = cachedData:FindFirstChild("Level")
        local so = cachedData:FindFirstChild("Sea") or cachedData:FindFirstChild("CurrentSea")
        local fo = cachedData:FindFirstChild("Fragments")
        if lo then lv  = tostring(lo.Value) end
        if so then sea = tostring(so.Value) end
        if fo then fr  = fmtNum(fo.Value)   end
    end

    statusLbl.Text = ("Lv.%s | Sea%s | Frag:%s | %s"):format(lv, sea, fr, t)
end)

-- ════════════════════════════════════════════
-- [M] TOGGLE
-- ════════════════════════════════════════════
local visible = true
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.M then
        visible = not visible
        tw(Root, { GroupTransparency = visible and 0 or 1 }, 0.3,
           Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end
end)

-- ════════════════════════════════════════════
-- BOOT ANIMATION — staggered 1.2s
-- ════════════════════════════════════════════
task.spawn(function()
    Root.GroupTransparency = 1
    task.wait(0.08)

    -- Step 1: fade entire Root in (0.7s)
    tw(Root, { GroupTransparency = 0 }, 0.7,
       Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    -- Step 2: border pulse on Bar (0.5s in)
    task.delay(0.5, function()
        local s = Bar:FindFirstChildOfClass("UIStroke")
        if s then
            tw(s, { Thickness = 2.2 }, 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            task.delay(0.22, function()
                tw(s, { Thickness = 1 }, 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            end)
        end
    end)

    -- Step 3: border pulse on Panel (0.75s in)
    task.delay(0.75, function()
        local s = Panel:FindFirstChildOfClass("UIStroke")
        if s then
            tw(s, { Thickness = 2.2 }, 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            task.delay(0.22, function()
                tw(s, { Thickness = 1 }, 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
            end)
        end
    end)

    task.delay(1.2, function()
        print("[ChuoiHub] ✓ Boot hoàn tất.")
    end)
end)
