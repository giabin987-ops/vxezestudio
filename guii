--- Format a number with comma separators: 54881186 → "54,881,186"
local function fmtNumber(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    return s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

--- Format elapsed seconds as "Xs" under 60, else "Xm Ys", else "Xh Ym"
local function fmtElapsed(t)
    t = math.floor(t)
    if t < 60 then
        return t .. "s"
    elseif t < 3600 then
        return math.floor(t/60) .. "m " .. (t%60) .. "s"
    else
        local h = math.floor(t/3600)
        local m = math.floor((t%3600)/60)
        return h .. "h " .. m .. "m"
    end
end

--- Tween a single property on any Instance
local function tween(obj, props, duration, style, direction, delay)
    style     = style     or Enum.EasingStyle.Quad
    direction = direction or Enum.EasingDirection.Out
    delay     = delay     or 0
    local info = TweenInfo.new(duration, style, direction)
    if delay > 0 then
        task.delay(delay, function()
            TweenService:Create(obj, info, props):Play()
        end)
    else
        TweenService:Create(obj, info, props):Play()
    end
end

