-- ════════════════════════════════════════════
-- HELPERS
-- ════════════════════════════════════════════
local function mkCorner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r); c.Parent = p
end

local function mkStroke(p, col, t)
    local s = Instance.new("UIStroke")
    s.Color = col or C.GOLD_BORDER
    s.Thickness = t or 1
    s.Parent = p
    return s
end

local function mkPad(p, l, r, t, b)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft   = UDim.new(0, l or 0)
    pad.PaddingRight  = UDim.new(0, r or 0)
    pad.PaddingTop    = UDim.new(0, t or 0)
    pad.PaddingBottom = UDim.new(0, b or 0)
    pad.Parent = p
end

local function mkFrame(parent, name, size, pos, bg, rad)
    local f = Instance.new("Frame")
    f.Name = name
    f.Size = size
    f.Position = pos or UDim2.new(0, 0, 0, 0)
    f.BackgroundColor3 = bg or C.PANEL
    f.BorderSizePixel = 0
    f.Parent = parent
    if rad then mkCorner(f, rad) end
    return f
end

local function mkLabel(p, name, text, size, pos, col, font, tsize, xalign, anchor)
    local l = Instance.new("TextLabel")
    l.Name = name; l.Text = text
    l.Size = size
    l.Position = pos or UDim2.new(0, 0, 0, 0)
    l.BackgroundTransparency = 1
    l.TextColor3 = col or C.WHITE
    l.FontFace = font or SEMI
    l.TextSize = tsize or 13
    l.TextXAlignment = xalign or Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.TextTruncate = Enum.TextTruncate.AtEnd
    if anchor then l.AnchorPoint = anchor end
    l.Parent = p
    return l
end

