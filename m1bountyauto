-- ================================================
-- AUTO BOUNTY SYSTEM - BLOX FRUITS
-- M1 Fruits Only | No UI | Config-Driven
-- ================================================

-- ================================================
-- DEFAULT CONFIG SETUP
-- ================================================
if not getgenv().configs then getgenv().configs = {} end

local configs = getgenv().configs

configs.SkipPlayerTime  = configs.SkipPlayerTime  or 10
configs.HopMode         = configs.HopMode         ~= nil and configs.HopMode or true
configs.AutoV3orV4      = configs.AutoV3orV4      ~= nil and configs.AutoV3orV4 or true
configs.AutoKenorBuso   = configs.AutoKenorBuso   ~= nil and configs.AutoKenorBuso or true
configs.SafeModeHP      = configs.SafeModeHP      or 40
configs.Team            = configs.Team            or "Pirate"
configs.TPMethod        = configs.TPMethod        or "Reset"

-- Extended sub-configs (auto-created if missing)
if not configs.Aim then
    configs.Aim = {
        Enabled         = true,
        Prediction      = 0.15,
        Smoothness      = 0.2,
        RandomizeOffset = 2
    }
end

if not configs.Awakening then
    configs.Awakening = {
        V3HP  = 60,   -- % HP to trigger V3
        V4HP  = 30,   -- % HP to trigger V4
        V3Key = "T",
        V4Key = "Y",
        V3Cooldown = 30,
        V4Cooldown = 60
    }
end

if not configs.Haki then
    configs.Haki = {
        KenKey    = "Q",  -- Observation Haki (Ken)
        BusoKey   = "E",  -- Armament Haki (Buso)
        Cooldown  = 15
    }
end

-- ================================================
-- SERVICE CACHE
-- ================================================
local Players             = game:GetService("Players")
local RunService          = game:GetService("RunService")
local TweenService        = game:GetService("TweenService")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")
local HttpService         = game:GetService("HttpService")
local TeleportService     = game:GetService("TeleportService")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- ================================================
-- INITIALIZATION
-- ================================================
print("[AutoBounty] Waiting for game to load...")
repeat task.wait(1) until game:IsLoaded()
repeat task.wait(0.5) until Players.LocalPlayer ~= nil

local LocalPlayer = Players.LocalPlayer

repeat task.wait(0.5) until LocalPlayer.Character ~= nil

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid  = Character:WaitForChild("Humanoid", 10)
local RootPart  = Character:WaitForChild("HumanoidRootPart", 10)

if not Humanoid or not RootPart then
    warn("[AutoBounty] Failed to get Humanoid or RootPart. Aborting.")
    return
end

print("[AutoBounty] Initialized successfully.")

-- ================================================
-- STATE VARIABLES
-- ================================================
local currentTarget      = nil
local skipList           = {}
local inSafeMode         = false
local attackDebounce     = false
local awakeningDebounce  = false
local hakiDebounce       = false
local v3Cooldown         = false
local v4Cooldown         = false
local kenCooldown        = false
local busoCooldown       = false
local noTargetTimer      = 0
local isRunning          = true
local maxNoTargetTime    = 30
local hoppedServers      = {}

-- ================================================
-- HELPER UTILITIES
-- ================================================

local function RefreshCharacter()
    Character = LocalPlayer.Character
    if Character then
        Humanoid = Character:FindFirstChild("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")
    end
end

local function GetHPPercent()
    RefreshCharacter()
    if not Humanoid then return 0 end
    if Humanoid.MaxHealth == 0 then return 100 end
    return (Humanoid.Health / Humanoid.MaxHealth) * 100
end

local function IsAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChild("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function IsInSafeZone(character)
    if not character then return true end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return true end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local name = v.Name:lower()
            if name:find("safe") or name:find("spawn") or name:find("nozone") then
                if (v.Position - root.Position).Magnitude < 60 then
                    return true
                end
            end
        end
    end
    return false
end

local function HasBounty(player)
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        local bounty = stats:FindFirstChild("Bounty") or stats:FindFirstChild("Beli")
        if bounty and tonumber(bounty.Value) then
            return tonumber(bounty.Value) > 0
        end
    end
    return true -- assume eligible if can't verify
end

local function IsSameTeam(player)
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function IsSkipped(player)
    if skipList[player] then
        if (tick() - skipList[player]) < configs.SkipPlayerTime then
            return true
        else
            skipList[player] = nil
        end
    end
    return false
end

local function DistanceTo(player)
    RefreshCharacter()
    if not RootPart then return math.huge end
    local char = player.Character
    if not char then return math.huge end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return math.huge end
    return (RootPart.Position - root.Position).Magnitude
end

local function SimulateKey(key, hold)
    pcall(function()
        local keyEnum = Enum.KeyCode[key] or key
        VirtualInputManager:SendKeyEvent(true, keyEnum, false, game)
        task.wait(hold or 0.05)
        VirtualInputManager:SendKeyEvent(false, keyEnum, false, game)
    end)
end

local function SimulateM1()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- ================================================
-- GET TARGET
-- ================================================

local function GetTarget()
    local bestPlayer = nil
    local bestDist   = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if not IsAlive(player) then continue end
        if IsSameTeam(player) then continue end
        if IsInSafeZone(player.Character) then continue end
        if not HasBounty(player) then continue end
        if IsSkipped(player) then continue end

        local dist = DistanceTo(player)
        if dist < bestDist then
            bestDist   = dist
            bestPlayer = player
        end
    end

    return bestPlayer
end

-- ================================================
-- SKIP TARGET TIMER
-- ================================================

local skipTimers = {}

local function SkipTargetTimer(player)
    if skipTimers[player] then return end
    skipTimers[player] = true

    task.delay(configs.SkipPlayerTime, function()
        if currentTarget == player and IsAlive(player) then
            print("[AutoBounty] Skipping unbeatable target:", player.Name)
            skipList[player] = tick()
            currentTarget    = nil
        end
        skipTimers[player] = nil
    end)
end

-- ================================================
-- PREDICT POSITION (SMART AIM)
-- ================================================

local function PredictPosition(player)
    if not player or not player.Character then return nil end
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local aim = configs.Aim
    if not aim or not aim.Enabled then
        return root.Position
    end

    local velocity = root.AssemblyLinearVelocity or root.Velocity
    local speed    = velocity.Magnitude
    local predicted

    if speed < 1 then
        predicted = root.Position
    else
        predicted = root.Position + (velocity * aim.Prediction)
    end

    local offset = aim.RandomizeOffset or 2
    predicted = predicted + Vector3.new(
        math.random(-offset * 10, offset * 10) / 10,
        0,
        math.random(-offset * 10, offset * 10) / 10
    )

    return predicted
end

-- ================================================
-- MOVEMENT (TP METHOD)
-- ================================================

local function LookAt(pos)
    RefreshCharacter()
    if not RootPart then return end
    local dir = (pos - RootPart.Position) * Vector3.new(1, 0, 1)
    if dir.Magnitude < 0.01 then return end
    RootPart.CFrame = CFrame.new(RootPart.Position, RootPart.Position + dir.Unit)
end

local function MoveToTarget(player)
    if not player or not player.Character then return end
    RefreshCharacter()
    if not RootPart then return end

    local predicted = PredictPosition(player)
    if not predicted then return end

    local direction  = predicted - RootPart.Position
    local dist       = direction.Magnitude
    local attackDist = 12
    local destination

    if dist > attackDist then
        destination = predicted - (direction.Unit * attackDist)
    else
        destination = RootPart.Position
    end

    LookAt(predicted)

    local method = configs.TPMethod

    if method == "Tween" then
        local info  = TweenInfo.new(configs.Aim.Smoothness or 0.2, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(RootPart, info, {CFrame = CFrame.new(destination)})
        tween:Play()
        task.wait(configs.Aim.Smoothness or 0.2)

    elseif method == "TP" then
        pcall(function() RootPart.CFrame = CFrame.new(destination) end)
        task.wait(0.05)

    else -- "Reset" (default)
        pcall(function() RootPart.CFrame = CFrame.new(destination) end)
        task.wait(0.1)
    end
end

-- ================================================
-- ATTACK TARGET (M1 SPAM)
-- ================================================

local function AttackTarget(player)
    if attackDebounce then return end
    if not player or not player.Character then return end
    RefreshCharacter()
    if not RootPart then return end

    local dist = DistanceTo(player)
    if dist > 20 then
        MoveToTarget(player)
        return
    end

    attackDebounce = true
    LookAt(player.Character.HumanoidRootPart.Position)

    pcall(function()
        -- M1 combo burst (3 clicks)
        for _ = 1, 3 do
            SimulateM1()
            task.wait(0.15)
        end
    end)

    task.wait(0.2)
    attackDebounce = false
end

-- ================================================
-- SAFE MODE (FLEE + RETURN)
-- ================================================

local function FleeFromTarget(player)
    RefreshCharacter()
    if not RootPart or not player or not player.Character then return end
    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local away    = (RootPart.Position - targetRoot.Position).Unit
    local fleePos = RootPart.Position + (away * 100) + Vector3.new(0, 35, 0)
    pcall(function() RootPart.CFrame = CFrame.new(fleePos) end)
end

local function HandleSafeMode(player)
    local hp = GetHPPercent()
    if hp <= configs.SafeModeHP then
        if not inSafeMode then
            print(string.format("[AutoBounty] SafeMode ON — HP: %.1f%%", hp))
        end
        inSafeMode = true
        pcall(function() RootPart.CFrame = RootPart.CFrame + Vector3.new(0, 40, 0) end)
        FleeFromTarget(player)
    else
        if inSafeMode then
            print("[AutoBounty] SafeMode OFF — HP recovered, returning.")
        end
        inSafeMode = false
    end
end

-- ================================================
-- AUTO KEN / BUSO (HAKI)
-- ================================================
-- Ken  (Observation) = dodge / evasion sense
-- Buso (Armament)    = damage boost / armor
-- Both are toggled via keypress at battle start & re-applied on cooldown

local function HandleKenorBuso()
    if not configs.AutoKenorBuso then return end
    if hakiDebounce then return end
    if not currentTarget then return end
    if IsInSafeZone(LocalPlayer.Character) then return end

    local haki = configs.Haki
    hakiDebounce = true

    -- Armament Haki (Buso) — activate when entering combat
    if not busoCooldown then
        busoCooldown = true
        print("[AutoBounty] Activating Buso Haki (" .. haki.BusoKey .. ")")
        SimulateKey(haki.BusoKey, 0.1)
        task.delay(haki.Cooldown, function() busoCooldown = false end)
    end

    task.wait(0.5)

    -- Observation Haki (Ken) — activate for dodge sense
    if not kenCooldown then
        kenCooldown = true
        print("[AutoBounty] Activating Ken Haki (" .. haki.KenKey .. ")")
        SimulateKey(haki.KenKey, 0.1)
        task.delay(haki.Cooldown, function() kenCooldown = false end)
    end

    task.wait(0.3)
    hakiDebounce = false
end

-- ================================================
-- AUTO V3 / V4 (RACE AWAKENING)
-- ================================================

local function HandleV3orV4()
    if not configs.AutoV3orV4 then return end
    if awakeningDebounce then return end
    if not currentTarget then return end
    if inSafeMode then return end
    if IsInSafeZone(LocalPlayer.Character) then return end

    local awk = configs.Awakening
    local hp  = GetHPPercent()
    awakeningDebounce = true

    -- V3 at configurable HP threshold
    if not v3Cooldown and hp <= awk.V3HP then
        v3Cooldown = true
        print(string.format("[AutoBounty] Activating V3 (%s) — HP: %.1f%%", awk.V3Key, hp))
        SimulateKey(awk.V3Key, 0.1)
        task.delay(awk.V3Cooldown, function() v3Cooldown = false end)
        task.wait(1)
    end

    -- V4 at lower HP threshold (emergency)
    if not v4Cooldown and hp <= awk.V4HP then
        v4Cooldown = true
        print(string.format("[AutoBounty] Activating V4 (%s) — HP: %.1f%%", awk.V4Key, hp))
        SimulateKey(awk.V4Key, 0.1)
        task.delay(awk.V4Cooldown, function() v4Cooldown = false end)
        task.wait(1)
    end

    awakeningDebounce = false
end

-- ================================================
-- SERVER HOP
-- ================================================

local function ServerHop()
    if not configs.HopMode then return end
    print("[AutoBounty] No targets found. Searching for a new server...")

    local placeId      = game.PlaceId
    local currentJobId = game.JobId

    local ok = pcall(function()
        local url      = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        local response = game:HttpGet(url)
        local data     = HttpService:JSONDecode(response)

        if data and data.data then
            for _, server in ipairs(data.data) do
                local jobId = server.id
                if jobId ~= currentJobId
                    and not hoppedServers[jobId]
                    and (server.playing or 0) < (server.maxPlayers or 20)
                then
                    hoppedServers[jobId] = true
                    print("[AutoBounty] Hopping to:", jobId)
                    TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
                    return
                end
            end
        end

        warn("[AutoBounty] No suitable server found. Retrying in 8s...")
        task.delay(8, ServerHop)
    end)

    if not ok then
        warn("[AutoBounty] ServerHop error. Retrying in 8s...")
        task.delay(8, ServerHop)
    end
end

-- ================================================
-- TEAM SELECTION
-- ================================================

local function SetTeam()
    pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("TeamSelect")
            or ReplicatedStorage:FindFirstChild("ChooseTeam")
            or ReplicatedStorage:FindFirstChild("SelectTeam")
        if remote then
            remote:FireServer(configs.Team)
            print("[AutoBounty] Team set to:", configs.Team)
        end
    end)
end

local function CheckTeam()
    if not LocalPlayer.Team then
        print("[AutoBounty] No team detected. Selecting:", configs.Team)
        SetTeam()
        task.wait(2)
    end
end

-- ================================================
-- CHARACTER RESPAWN HANDLER
-- ================================================

LocalPlayer.CharacterAdded:Connect(function(newChar)
    print("[AutoBounty] Character respawned. Reinitializing...")
    Character    = newChar
    Humanoid     = newChar:WaitForChild("Humanoid", 10)
    RootPart     = newChar:WaitForChild("HumanoidRootPart", 10)
    currentTarget    = nil
    inSafeMode       = false
    attackDebounce   = false
    hakiDebounce     = false
    awakeningDebounce = false
    busoCooldown     = false
    kenCooldown      = false
    task.wait(3) -- grace period before resuming
end)

-- ================================================
-- MAIN LOOP
-- ================================================

print("[AutoBounty] Script started.")
print(string.format(
    "  Team: %s | TPMethod: %s | HopMode: %s | SafeHP: %d%% | AutoV3V4: %s | AutoHaki: %s",
    configs.Team,
    configs.TPMethod,
    tostring(configs.HopMode),
    configs.SafeModeHP,
    tostring(configs.AutoV3orV4),
    tostring(configs.AutoKenorBuso)
))

CheckTeam()

task.spawn(function()
    while isRunning do
        local ok, err = pcall(function()
            RefreshCharacter()

            -- Guard: character not ready
            if not Character or not Humanoid or not RootPart then
                task.wait(2)
                return
            end

            -- Guard: dead
            if Humanoid.Health <= 0 then
                task.wait(2)
                return
            end

            -- Safe mode check (flee if low HP)
            if currentTarget then
                HandleSafeMode(currentTarget)
            end

            if inSafeMode then
                task.wait(0.5)
                return
            end

            -- Awakening & Haki (non-blocking)
            task.spawn(HandleV3orV4)
            task.spawn(HandleKenorBuso)

            -- Target acquisition
            if not currentTarget
                or not IsAlive(currentTarget)
                or IsInSafeZone(currentTarget.Character)
            then
                currentTarget = GetTarget()

                if not currentTarget then
                    noTargetTimer += 1
                    print(string.format(
                        "[AutoBounty] No target (%d/%d). Waiting...",
                        noTargetTimer, maxNoTargetTime
                    ))
                    if noTargetTimer >= maxNoTargetTime then
                        noTargetTimer = 0
                        ServerHop()
                    end
                    task.wait(1)
                    return
                end

                noTargetTimer = 0
                print("[AutoBounty] Locked onto target:", currentTarget.Name)
                SkipTargetTimer(currentTarget)
            end

            -- Combat cycle: move → attack
            MoveToTarget(currentTarget)
            AttackTarget(currentTarget)
        end)

        if not ok then
            warn("[AutoBounty] Loop error:", err)
        end

        task.wait(0.2)
    end
end)
